                      "data": {}
                    }
                  ]
                },
                {
									"nodeType": "paragraph",
									"data": {},
									"content": [
                    {
											"nodeType": "text",
											"value": "What does the Census or customer data mean when it comes to a client’s business upside?",
											"marks": [],
											"data": {}
                    }
									]
                },
								{
									"nodeType": "unordered-list",
