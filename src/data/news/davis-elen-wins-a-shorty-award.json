                      "data": {}
                    }
                  ]
                },
                {
                  "nodeType": "heading-2",
                  "data": {},
                  "content": [
                    {
                      "nodeType": "text",
                      "value": "Solving Real Problems",
                      "marks": [],
                      "data": {}
                    }
                  ]
                },
                {
                  "nodeType": "paragraph",
                  "data": {},
                  "content": [
                    {
                      "nodeType": "text",
                      "value": "We start by looking at the constraints. That’s where genuine problem-solving happens. We paired a grounded approach with human imagination to turn healthcare technology into an essential daily utility.",
