                  }
                ]
              },
              {
                "nodeType": "paragraph",
                "data": {},
                "content": [
                  {
                    "nodeType": "text",
                    "value": "WINNER: GOLD, NON BROADCAST, TITLE DESIGN",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ],
                    "data": {}
                  },
                  {
                    "nodeType": "text",
