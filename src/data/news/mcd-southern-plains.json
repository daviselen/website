        "title": {
          "en-US": "McDonald’s Southern Plains Association Co-op Selects Davis Elen as Local Agency"
        },
        "publishedAt": {
          "en-US": "2019-05-01T10:56:00"
        },
        "categories": {
          "en-US": [
